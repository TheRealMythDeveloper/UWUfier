
{
  "manifest_version": 3,
  "name": "UWUfier",
  "version": "1.1",
  "description": "Turns the internet into UWU.",
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
